# SmartNotes 环境配置示例
# 复制此文件为 .env 并填入实际值

# 数据库连接
DSN=root:password@tcp(localhost:3306)/smartnotes?charset=utf8mb4&parseTime=True&loc=Local

# 阿里云百炼 API
API_KEY=sk-your-api-key-here
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen-plus

# 服务配置
PORT=6768

# 访问验证码（请修改为复杂密码）
AUTH_CODE=smartnotes2024